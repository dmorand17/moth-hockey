# PRODUCTION env for M.O.T.H Hockey (Supabase project ref fpvqzzkauhifixnzppwh).
#
#   cp .env.production.example .env.production
#   set -a; source .env.production; set +a     # load into your shell for the scripts
#
# App runtime vars (NEXT_PUBLIC_*) on Vercel are set in the Vercel dashboard per
# environment — these are here for reference. The SUPABASE_* vars drive the
# tooling scripts (link, db push). Treat prod credentials with extra care.
#
# NEVER commit a file with real values — only .env.*.example templates are tracked.

# ─── App runtime (Next.js) ────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://fpvqzzkauhifixnzppwh.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SITE_URL=""

# ─── Tooling / CLI (scripts) ──────────────────────────────────────────────
SUPABASE_ENV="production"
SUPABASE_PROJECT_REF="fpvqzzkauhifixnzppwh"

# Personal access token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""

# Database password (Dashboard → Project Settings → Database).
# Used by scripts/supabase-link.sh.
SUPABASE_DB_PASSWORD=""

# Session-pooler connection string (port 5432), if you ever reseed prod.
SUPABASE_DB_URL="postgresql://postgres.fpvqzzkauhifixnzppwh:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── New-user notification webhook (server runtime) ───────────────────────
# Set these in the Vercel project (Production env), NOT NEXT_PUBLIC. Used by
# app/api/hooks/new-user to email an admin when someone registers. See
# docs/EMAIL.md for the Supabase Database Webhook setup.
NEW_USER_WEBHOOK_SECRET=""        # shared secret; also set as the webhook's x-webhook-secret header
ADMIN_NOTIFY_EMAIL=""             # who gets the "new signup" email
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"                   # 465 = SSL/TLS, 587 = STARTTLS
SMTP_USER=""                      # full mailbox address, e.g. noreply@yourdomain
SMTP_PASS=""
SMTP_FROM=""                      # defaults to SMTP_USER if unset
