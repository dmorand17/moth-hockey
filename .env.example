# Copy to .env.local for local dev, or set these in the Vercel dashboard for deployments.
# Local dev values come from `supabase status` (anon key is safe to expose; the
# service role key is NOT — never commit it, never expose it client-side).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
