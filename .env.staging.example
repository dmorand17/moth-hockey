# STAGING env for M.O.T.H Hockey (Supabase project ref ecvktaljsvrecozmfayj).
#
#   cp .env.staging.example .env.staging
#   set -a; source .env.staging; set +a     # load into your shell for the scripts
#
# App runtime vars (NEXT_PUBLIC_*) on Vercel are set in the Vercel dashboard per
# environment — these are here for reference / running the app locally against
# staging. The SUPABASE_* vars drive the tooling scripts (link, reset, db push).
#
# NEVER commit a file with real values — only .env.*.example templates are tracked.

# ─── App runtime (Next.js) ────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://ecvktaljsvrecozmfayj.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SITE_URL=""

# ─── Tooling / CLI (scripts) ──────────────────────────────────────────────
SUPABASE_ENV="staging"
SUPABASE_PROJECT_REF="ecvktaljsvrecozmfayj"

# Personal access token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""

# Database password (Dashboard → Project Settings → Database).
# Used by scripts/supabase-link.sh.
SUPABASE_DB_PASSWORD=""

# Session-pooler connection string (port 5432) for scripts/reset-staging.sh.
# Dashboard → Project Settings → Database → Connection string → Session pooler.
SUPABASE_DB_URL="postgresql://postgres.ecvktaljsvrecozmfayj:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── New-user notification webhook (server runtime) ───────────────────────
# Set these in the Vercel project (Preview/staging env), NOT NEXT_PUBLIC. Used by
# app/api/hooks/new-user to email an admin when someone registers. See
# docs/EMAIL.md for the Supabase Database Webhook setup.
NEW_USER_WEBHOOK_SECRET=""        # shared secret; also set as the webhook's x-webhook-secret header
ADMIN_NOTIFY_EMAIL=""             # who gets the "new signup" email
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"                   # 465 = SSL/TLS, 587 = STARTTLS
SMTP_USER=""                      # full mailbox address, e.g. noreply@yourdomain
SMTP_PASS=""
SMTP_FROM=""                      # defaults to SMTP_USER if unset
