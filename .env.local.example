# LOCAL development env for M.O.T.H Hockey.
#
#   cp .env.local.example .env.local     # Next.js auto-loads .env.local
#
# Values point at the local Supabase stack from `bunx supabase start`
# (run `bunx supabase status` for the URL + anon/"publishable" key).
#
# NEVER commit a file with real values — only .env.*.example templates are
# tracked (see .gitignore).

# ─── App runtime (Next.js) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Absolute base URL for OpenGraph/metadata links. Optional locally
# (defaults to http://localhost:3001).
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
