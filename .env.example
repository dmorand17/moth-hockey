# Environment variables for M.O.T.H Hockey — the one template for every setup.
#
#   Local dev:       cp .env.example .env.local        (Next.js loads it automatically)
#                    Fill the "App" section; `bunx supabase status` prints the local
#                    URL, publishable key and secret key.
#   Staging / prod:  set the "App" section in the Vercel dashboard per environment.
#   Scripts:         cp .env.example .env.staging   (or .env.production) and fill the
#                    "Scripts" section; scripts/supabase-push.sh and
#                    scripts/reset-staging.sh load these files themselves.
#
# Leave a variable empty if you don't need that feature. NEVER commit real values:
# only this template is tracked (see .gitignore).

# ═══ App (Next.js runtime) ═══════════════════════════════════════════════════

# Supabase project. Local: http://127.0.0.1:54321. Cloud: Dashboard → Project
# Settings → API. Staging ref ecvktaljsvrecozmfayj, production ref fpvqzzkauhifixnzppwh.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Absolute base URL for OpenGraph/metadata links. Falls back to Vercel's
# production URL, then http://localhost:3001.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Server only — never prefix with NEXT_PUBLIC_. Service-role key for background
# jobs (write-up cron). Local: `bunx supabase status` → "Secret".
SUPABASE_SECRET_KEY=""

# AI game write-ups and the season recap summary, via OpenRouter. Empty model
# vars use the defaults in lib/write-ups/openrouter.ts.
OPENROUTER_API_KEY=""
WRITE_UP_MODEL=""
WRITE_UP_FALLBACK_MODEL=""

# Recap photo/video uploads (Vercel Blob store "moth-hockey-media"). Copy from
# the Vercel project or `vercel env pull`. Outside production, uploads land under
# dev/ in the same store. Without it, the recap uploader is disabled.
BLOB_READ_WRITE_TOKEN=""

# Vercel sends this to the write-up cron as `Authorization: Bearer ...`.
CRON_SECRET=""

# New-signup email to an admin (app/api/hooks/new-user). See docs/EMAIL.md for
# the Supabase Database Webhook setup.
NEW_USER_WEBHOOK_SECRET=""        # also set as the webhook's x-webhook-secret header
ADMIN_NOTIFY_EMAIL=""             # who gets the "new signup" email
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"                   # 465 = SSL/TLS, 587 = STARTTLS
SMTP_USER=""                      # full mailbox address, e.g. noreply@yourdomain
SMTP_PASS=""
SMTP_FROM=""                      # defaults to SMTP_USER if unset

# ═══ Scripts (.env.staging / .env.production only) ═══════════════════════════

# "staging" or "production" — supabase-push.sh refuses to run if this doesn't
# match the target you asked for.
SUPABASE_ENV=""
# staging: ecvktaljsvrecozmfayj · production: fpvqzzkauhifixnzppwh
SUPABASE_PROJECT_REF=""

# Personal access token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""

# Database password (Dashboard → Project Settings → Database). Used by supabase-push.sh.
SUPABASE_DB_PASSWORD=""

# Session-pooler connection string (port 5432) for reset-staging.sh.
# Dashboard → Project Settings → Database → Connection string → Session pooler.
SUPABASE_DB_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
